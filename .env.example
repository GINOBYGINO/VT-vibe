# Optional cookies path is via env YTDLP_COOKIES (not committed).
# Download default is 1080p (prefer 60fps). Old jobs stay 720p until you re-run step 01.

# ASR / subtitle engines
# USE_WHISPERX_FOR_SUBTITLE=1  → Module2 uses faster-whisper; Module5 uses WhisperX
# SUBTITLE_AB_TEST5=1          → test5 writes fast+whisperx variants (breaks step 6–8 naming; keep 0)
# OUTPUT_VERSION=v1.1          → export under outputs/v1.1/<alias>/
OUTPUT_VERSION=v1.1
USE_WHISPERX_FOR_SUBTITLE=1
SUBTITLE_AB_TEST5=0

# Optional: Netscape cookies file (most reliable on Windows)
# YTDLP_COOKIES=D:\path\to\cookies.txt
# YTDLP_BROWSER=chrome

# Studio API（手機／bestwox 操作頁經 Tunnel 連本機時改 0.0.0.0）
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8787
